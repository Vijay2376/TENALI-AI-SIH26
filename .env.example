# =============================================================================
# TENALI AI - Environment Variables Configuration
# =============================================================================

# Server settings
HOST=127.0.0.1
PORT=8080
DEBUG=True

# Mode Control
# When true, uses deterministic local routing and specialist demo adapters
TENALI_DEMO_MODE=true

# Optional: Google Gemini API Key for dynamic query reasoning and LLM answer synthesis
# (If left blank, TENALI AI uses deterministic local pattern routing and BigEarthNet-adapted classifier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
